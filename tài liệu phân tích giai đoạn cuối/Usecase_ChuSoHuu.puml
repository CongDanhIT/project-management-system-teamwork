@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #f9f9f9
    BorderColor #333333
    ArrowColor #666666
}
skinparam actor {
    BackgroundColor #ffffff
    BorderColor #333333
}

actor "Chủ sở hữu\n(Owner)" as Owner

rectangle "Phân hệ Chủ sở hữu - Hệ thống Quản lý Dự án" {

    ' Các Use Case Độc quyền của Owner
    usecase "Khởi tạo Không gian làm việc" as UC_Create
    usecase "Xóa vĩnh viễn Workspace (Hard Delete)" as UC_Delete
    
    usecase "Cập nhật Thông tin Workspace (Brand Identity)" as UC_Update
    usecase "Đặt lại Mã mời tham gia (Reset Invite Code)" as UC_Reset
    
    usecase "Thiết lập Tích hợp & Bảo mật (Webhooks/Audit Log)" as UC_Config
}

' Liên kết từ Actor đến các Base Use Cases
Owner -- UC_Create
Owner -- UC_Delete
Owner -- UC_Update
Owner -- UC_Config

' QUAN HỆ EXTEND: Đặt lại mã mời là một thao tác mở rộng của việc Cập nhật thông tin
UC_Reset .u.> UC_Update : <<extend>>

@enduml
