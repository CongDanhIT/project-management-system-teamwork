@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #f9f9f9
    BorderColor #333333
    ArrowColor #666666
}
skinparam actor {
    BackgroundColor #ffffff
    BorderColor #333333
}

' Định nghĩa các Actor con người (Human Actors)
actor "Chủ sở hữu\n(Owner)" as Owner
actor "Quản trị viên\n(Admin)" as Admin
actor "Thành viên\n(Member)" as Member

' Thiết lập quan hệ kế thừa (Generalization) giữa các Actor con người
Owner -left-|> Admin : "<<kế thừa>>"
Admin -left-|> Member : "<<kế thừa>>"

' Ranh giới hệ thống (System Boundary)
rectangle "Hệ thống Quản lý Dự án - Phân hệ Phân tích và Báo cáo" {
    
    ' Các Use Case nghiệp vụ chính (Base Use Cases)
    usecase "Theo dõi Dashboard Thống kê" as UC_ViewDashboard
    usecase "Truy xuất Nhật ký hoạt động\n(View Audit Log)" as UC_ViewAuditLog
    usecase "Xuất báo cáo dự án" as UC_ExportReport

    ' Các Use Case bổ trợ kỹ thuật (Included Use Cases)
    usecase "Kiểm tra quyền truy cập" as UC_CheckPermission
    usecase "Truy xuất dữ liệu lịch sử\n(Snapshot & Audit Trail)" as UC_RetrieveData

    ' Các Use Case mở rộng tùy chọn (Extended Use Cases)
    usecase "Xem Sơ đồ Gantt Chart" as UC_ViewGantt
    usecase "Trích xuất báo cáo Excel" as UC_ExportExcel
    usecase "Trích xuất báo cáo PDF" as UC_ExportPDF
}

' Liên kết giữa Actor con người và các ca sử dụng tương tác (Association - Đường liền nét)
' Member có quyền xem dashboard tiến độ của dự án/cá nhân mình
Member -- UC_ViewDashboard

' Admin và Owner có đặc quyền xem nhật ký hoạt động của hệ thống và xuất báo cáo
Admin -- UC_ViewAuditLog
Admin -- UC_ExportReport

' Quan hệ Bao gồm (<<include>>) - Nét đứt (..>), từ Base đến Included
UC_ViewDashboard ..> UC_CheckPermission : "<<include>>"
UC_ViewAuditLog ..> UC_CheckPermission : "<<include>>"
UC_ExportReport ..> UC_CheckPermission : "<<include>>"

' Việc thống kê và xuất báo cáo bắt buộc phải gọi logic truy xuất dữ liệu từ DB (Daily snapshots và Activity logs)
UC_ViewDashboard ..> UC_RetrieveData : "<<include>>"
UC_ViewAuditLog ..> UC_RetrieveData : "<<include>>"
UC_ExportReport ..> UC_RetrieveData : "<<include>>"

' Quan hệ Mở rộng (<<extend>>) - Nét đứt (..>), từ Extended ngược về Base
' Xem sơ đồ Gantt mở rộng khả năng hiển thị của Dashboard thống kê tiến độ
UC_ViewGantt .u.> UC_ViewDashboard : "<<extend>>"
' Trích xuất Excel và PDF mở rộng tùy chọn định dạng khi xuất báo cáo
UC_ExportExcel .u.> UC_ExportReport : "<<extend>>"
UC_ExportPDF .u.> UC_ExportReport : "<<extend>>"

@enduml
